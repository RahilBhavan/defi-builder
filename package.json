{
  "name": "defi-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "audit": "bun pm audit",
    "audit:all": "bun pm audit && cd backend && bun pm audit",
    "audit:fix": "bun pm audit --fix && cd backend && bun pm audit --fix",
    "security:audit": "./scripts/security-audit.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "NODE_OPTIONS='--no-warnings' vitest",
    "test:ui": "NODE_OPTIONS='--no-warnings' vitest --ui",
    "test:coverage": "NODE_OPTIONS='--no-warnings' vitest --coverage",
    "test:frontend": "NODE_OPTIONS='--no-warnings' vitest",
    "test:backend": "cd backend && bun test",
    "test:all": "bun run test:frontend -- --run && bun run test:backend -- --run",
    "test:mock": "vitest __tests__/examples/mock-api-usage.test.ts",
    "mock:server": "bun run backend/src/mocks/startMockServer.ts",
    "mock:server:bull": "MOCK_SCENARIO=bull_market bun run backend/src/mocks/startMockServer.ts",
    "mock:server:bear": "MOCK_SCENARIO=bear_market bun run backend/src/mocks/startMockServer.ts",
    "mock:server:crash": "MOCK_SCENARIO=flash_crash bun run backend/src/mocks/startMockServer.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@metamask/sdk": "^0.34.0",
    "@sentry/react": "^10.32.1",
    "@tanstack/react-query": "^5.90.15",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@xyflow/react": "^12.10.0",
    "dagre": "^0.8.5",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "uuid": "^13.0.0",
    "viem": "^2.43.3",
    "wagmi": "^3.1.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/addon-interactions": "^8.6.15",
    "@storybook/addon-links": "^8.6.15",
    "@storybook/blocks": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/dagre": "^0.7.52",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^8.6.15",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  }
}
