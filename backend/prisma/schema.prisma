generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  email         String?
  username      String?
  bio           String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  strategies    Strategy[]
  ratings       Rating[]
  reviews       Review[]
  forks         StrategyFork[]

  @@index([walletAddress])
  @@index([username])
}

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  nodeGraph   String   @default("{}") // Store ReactFlow node graph as JSON string
  isPublic    Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  category    String?  // e.g., "yield-farming", "arbitrage", "liquidity"
  tags        String   @default("[]") // JSON array of tags
  viewCount   Int      @default(0)
  forkCount   Int      @default(0)
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings     Rating[]
  reviews     Review[]
  originalForks StrategyFork[] @relation("OriginalStrategy")
  forkedFrom   StrategyFork[]  @relation("ForkedStrategy")

  @@index([userId])
  @@index([isPublic])
  @@index([isFeatured])
  @@index([category])
  @@index([createdAt])
}

model Rating {
  id         String   @id @default(cuid())
  strategyId String
  userId     String
  rating     Int      // 1-5 stars
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([strategyId, userId])
  @@index([strategyId])
  @@index([userId])
}

model Review {
  id         String   @id @default(cuid())
  strategyId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([strategyId])
  @@index([userId])
}

model StrategyFork {
  id          String   @id @default(cuid())
  originalId  String
  forkedId     String
  userId      String
  createdAt   DateTime @default(now())

  original    Strategy @relation("OriginalStrategy", fields: [originalId], references: [id], onDelete: Cascade)
  forked      Strategy @relation("ForkedStrategy", fields: [forkedId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([originalId])
  @@index([forkedId])
  @@index([userId])
}

model BacktestResult {
  id          String   @id @default(cuid())
  strategyId  String
  parameters  String   @default("{}") // Backtest configuration as JSON string
  results     String   @default("{}") // Performance metrics as JSON string
  createdAt   DateTime @default(now())

  @@index([strategyId])
}

model AuditLog {
  id          String   @id @default(cuid())
  eventType   String   // AuditEventType enum value
  userId      String?
  walletAddress String?
  ipAddress   String?
  userAgent   String?
  metadata    String   @default("{}") // JSON string
  success     Boolean
  errorMessage String?
  timestamp   DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([walletAddress])
  @@index([timestamp])
}

